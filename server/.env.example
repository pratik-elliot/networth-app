# Copy this file to ".env" and fill in real values before running the server.

# Any long random string — used to sign login sessions (JWTs).
JWT_SECRET=change-this-to-a-long-random-string

# Where the SQLite database file should be created (created automatically).
DB_PATH=./data/networth.db

# Where uploaded account images are stored (created automatically).
UPLOAD_DIR=./uploads

# Port the API server listens on.
PORT=4000

# The URL of your deployed frontend (used for CORS). For local dev:
CLIENT_ORIGIN=http://localhost:5173

# --- Email delivery for OTP (2-factor login) codes ---------------------
# If these are left blank, OTP codes are printed to the server console
# instead of emailed — useful for local testing, NOT for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Net Worth Ledger <no-reply@example.com>"

# How long an OTP code stays valid, in minutes.
OTP_TTL_MINUTES=10
