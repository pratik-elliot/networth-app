# Copy this file to ".env" and fill in real values before running the server.

# Any long random string — used to sign login sessions (JWTs).
JWT_SECRET=change-this-to-a-long-random-string

# MongoDB connection string (MongoDB Atlas or a local mongod).
# Required — the server will not start without it.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
# Database name inside that cluster.
MONGODB_DB=networth

# Port the API server listens on.
PORT=4000

# The URL of your deployed frontend (used for CORS). For local dev:
CLIENT_ORIGIN=http://localhost:5173

# --- Email delivery for OTP (2-factor login) codes ---------------------
# If nothing below is set, OTP codes are printed to the server console
# instead of emailed — useful for local testing, NOT for production.
#
# Option A (preferred): Resend's HTTP API. Works even on hosts that block
# outbound SMTP ports, because it sends over HTTPS. Get a key at resend.com.
RESEND_API_KEY=
# Sender address. Leave blank to use Resend's sandbox sender, which only
# delivers to the email that owns the Resend account. Verify your own domain
# in Resend to send anywhere else.
MAIL_FROM="Net Worth Ledger <onboarding@resend.dev>"

# Option B: plain SMTP. Used only when RESEND_API_KEY is empty. Note that
# Render's free instances block outbound ports 25/465/587, so this needs a
# paid plan there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Net Worth Ledger <no-reply@example.com>"

# How long an OTP code stays valid, in minutes.
OTP_TTL_MINUTES=10
